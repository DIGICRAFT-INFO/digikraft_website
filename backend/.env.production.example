# ============================================================
# DigiKraft Social Backend — Production Environment Variables
# COPY this file to .env on your server and fill in real values
# NEVER commit the real .env file to Git
# ============================================================

NODE_ENV=production
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get from: Atlas → Clusters → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dks-website?retryWrites=true&w=majority

# ── JWT Secrets ───────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Each portal gets its own secret — NEVER reuse
JWT_SECRET=<64-byte-hex-for-cms>
JWT_CRM_SECRET=<64-byte-hex-for-crm>
JWT_HRM_SECRET=<64-byte-hex-for-hrm>
JWT_EMP_SECRET=<64-byte-hex-for-emp>

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://digikraftsocial.com,https://www.digikraftsocial.com
